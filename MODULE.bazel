module(name = "main")

bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "grpc", version = "1.76.0")
bazel_dep(name = "rules_python", version = "1.8.1")
bazel_dep(name = "rules_cc", version = "0.2.14")

